---
/**
 * Lightweight arithmetic "are you human" gate, matching the original site's
 * pattern - keeps the submit button disabled until the sum is answered
 * correctly. The two operands travel as hidden fields and are re-checked
 * server-side in src/lib/apiHandler.ts, so it's more than cosmetic, but it's
 * still a simple client-visible sum, not real bot protection. Swap for
 * Cloudflare Turnstile (or similar) if that's added later - this component
 * and its hidden fields can be removed as a unit.
 */
---
<div data-captcha class="flex items-center gap-2.5 flex-wrap">
  <label class="text-sm text-(--color-text)" for="captcha-answer">
    Para confirmar que sos humano, resolvé: <span class="captcha-question font-(family-name:--font-heading) font-semibold">...</span>
  </label>
  <input type="number" inputmode="numeric" id="captcha-answer" name="captcha_answer" class="input captcha-answer !w-16 flex-none text-center" required aria-label="Resultado de la verificación" />
  <input type="hidden" name="captcha_a" class="captcha-a" />
  <input type="hidden" name="captcha_b" class="captcha-b" />
</div>
