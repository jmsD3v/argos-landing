---
export interface Props {
  label: string;
  aspect?: string;
  class?: string;
}
const { label, aspect = '16/11', class: className = '' } = Astro.props;
---

<div
  class:list={['flex items-center justify-center rounded-(--radius-lg) border-2 border-dashed border-(--color-divider) bg-(--color-surface) text-center px-6', className]}
  style={{ aspectRatio: aspect }}
>
  <span class="text-sm opacity-60 max-w-[28ch]">{label}</span>
</div>
