---
const stats = [
  { id: 'stat-tools', target: 6, step: 1, label: 'Herramientas OSINT incluidas', suffix: '' },
  { id: 'stat-contributors', target: 26, step: 2, label: 'Colaboradores activos', suffix: '' },
  { id: 'stat-open', target: 100, step: 5, label: 'Código abierto y colaborativo', suffix: '%' },
];
---

<section class="max-w-[1280px] mx-auto px-6 py-14 border-b-2 border-(--color-divider)">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-left">
    {stats.map((s) => (
      <div>
        <p class="font-(family-name:--font-heading) font-bold text-[clamp(34px,4vw,48px)] text-(--color-accent) m-0">
          <span id={s.id} data-target={s.target} data-step={s.step}>0</span>{s.suffix}
        </p>
        <p class="text-[13px] tracking-wide uppercase opacity-70 mt-1.5 mb-0">{s.label}</p>
      </div>
    ))}
  </div>
</section>
