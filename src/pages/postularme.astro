---
import BaseLayout from '../layouts/BaseLayout.astro';
import MathCaptcha from '../components/MathCaptcha.astro';
import { applicationRoles } from '../data/team';
---

<BaseLayout title="Postularme — argOS" current="postularme">
  <section class="max-w-[1000px] mx-auto px-6 pt-16 pb-6">
    <h6 class="text-(--color-accent-700)">Voluntariado</h6>
    <h1 class="text-[clamp(28px,3.8vw,40px)] mb-5">Sumate como Voluntario a argOS</h1>
    <p class="opacity-80 text-[15px] mb-3.5">¿Querés formar parte de un proyecto regional de alto impacto en ciberinteligencia y OSINT? Estamos buscando personas apasionadas, con ganas de aprender, crear y colaborar en el desarrollo de argOS: el primer sistema operativo latinoamericano enfocado en ciberinteligencia.</p>
    <p class="opacity-80 text-[15px] mb-2.5">Podés sumarte en las siguientes áreas:</p>
    <ul class="opacity-80 text-[15px] mb-3.5 pl-5">
      <li>Desarrolladores (Linux/Debian)</li>
      <li>Desarrolladores WordPress</li>
      <li>Tool Testers (prueba y análisis de herramientas)</li>
      <li>Diseñadores UX/UI</li>
      <li>Comunidad y redes sociales</li>
    </ul>
    <p class="opacity-80 text-[15px] m-0">No importa tu nivel actual: buscamos compromiso, ética y voluntad de aportar. La participación es voluntaria y ad honórem.</p>
  </section>

  <section class="max-w-[1000px] mx-auto px-6 py-6 pb-20">
    <form action="/api/postularme" method="post" data-enhance data-loading-label="Enviando..." data-success-target="postularme-success" class="flex flex-col gap-4.5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4.5">
        <div class="field"><label for="p-nombre">Nombre</label><input class="input" id="p-nombre" name="nombre" required /></div>
        <div class="field"><label for="p-apellido">Apellido</label><input class="input" id="p-apellido" name="apellido" required /></div>
        <div class="field"><label for="p-pais">País</label><input class="input" id="p-pais" name="pais" required /></div>
        <div class="field"><label for="p-ciudad">Ciudad</label><input class="input" id="p-ciudad" name="ciudad" /></div>
        <div class="field"><label for="p-mail">Mail</label><input class="input" type="email" id="p-mail" name="mail" required /></div>
        <div class="field"><label for="p-whatsapp">WhatsApp</label><input class="input" id="p-whatsapp" name="whatsapp" /></div>
        <div class="field"><label for="p-linkedin">LinkedIn</label><input class="input" id="p-linkedin" name="linkedin" /></div>
        <div class="field">
          <label for="p-rol">Me postulo para</label>
          <select class="input" id="p-rol" name="rol">
            <option value="">Elegí un área</option>
            {applicationRoles.map((r) => <option value={r.value}>{r.label}</option>)}
          </select>
        </div>
      </div>
      <div class="field"><label for="p-experiencia">Tengo experiencia en</label><textarea class="input" id="p-experiencia" name="experiencia"></textarea></div>
      <MathCaptcha />
      <p data-form-error class="text-red-700 text-xs m-0" role="alert"></p>
      <button type="submit" class="btn btn-primary max-w-[260px] rounded-full justify-center">Enviar Postulación</button>
    </form>
    <div id="postularme-success" hidden class="elev-sm bg-(--color-accent-100) p-8 rounded-(--radius-lg)">
      <h3 class="mb-2 text-(--color-accent-800)">¡Postulación enviada!</h3>
      <p class="opacity-80 text-sm m-0">Gracias por sumarte a argOS. Te contactaremos para coordinar una breve entrevista.</p>
    </div>
  </section>

  <script>
    import { enhanceAllForms } from '../scripts/enhance-form';
    enhanceAllForms();
  </script>
</BaseLayout>
